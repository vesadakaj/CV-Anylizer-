# Anthropic API key used by the CV and job-description extractors.
LLM_API_KEY=

# Database. Either give a full SQLAlchemy URL...
#DATABASE_URL=
# ...or leave it unset and the MSSQL connection string is built from these
# (Windows integrated auth, TrustServerCertificate=yes).
DB_SERVER=
DB_NAME=
DB_DRIVER=

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
