# Anthropic API key used by the CV and job-description extractors. A missing
# key fails at the first extraction with a clear message, not at startup.
LLM_API_KEY=

# Database. Either give a full SQLAlchemy URL...
#   DATABASE_URL=mssql+pyodbc:///?odbc_connect=...
#   DATABASE_URL=sqlite:///./local.db          (local development without MSSQL)
#DATABASE_URL=
# ...or leave it unset and the MSSQL connection string is built from these
# (Windows integrated auth, TrustServerCertificate=yes).
DB_SERVER=
DB_NAME=
DB_DRIVER=ODBC Driver 18 for SQL Server

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Secret used to sign login tokens (HS256, 12 hours). Required; the API
# refuses to start without it. Use 32+ random bytes, e.g. `openssl rand -hex 32`.
JWT_SECRET=
